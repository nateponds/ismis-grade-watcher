# ISMIS credentials
ISMIS_USERNAME=19020241
ISMIS_PASSWORD=your_password_here

# Gmail SMTP (use an App Password, not your real password)
# https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxx

# Who receives the grade alerts (can be same as GMAIL_USER)
NOTIFY_EMAIL=your_email@gmail.com

# How often to check (cron syntax)
# "0 * * * *"   = every hour
# "*/30 * * * *" = every 30 minutes
# "0 8,20 * * *" = 8 AM and 8 PM daily
CHECK_CRON=0 * * * *
